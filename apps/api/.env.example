# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=
# Stored runs are keyed by this name, so changing it re-judges every label. A new release
# behind jev-latest only reaches newly judged labels; stored ones keep their old answers.
TYPESAFE_MODEL=jev-latest
# The Jev version the Gate 1 thresholds were validated on (see PLAN.md, Model version).
VALIDATED_MODEL_VERSION=jev-1.13.0
OPENFDA_API_KEY=
DATABASE_URL=sqlite:///rx_jev.db
