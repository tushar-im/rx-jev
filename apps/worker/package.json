{
  "name": "rx-jev-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p test/node",
    "types": "wrangler types --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:import": "node scripts/import-store.ts",
    "tools:precompute": "node --env-file-if-exists=.dev.vars scripts/precompute-review-set.ts",
    "tools:review-sheet": "node --env-file-if-exists=.dev.vars scripts/build-review-sheet.ts",
    "tools:second-read": "node scripts/second-read.ts"
  },
  "dependencies": {
    "@rx-jev/contract": "*",
    "@typesafe-ai/sdk": "^0.6.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.11",
    "vitest": "^4.1.0",
    "wrangler": "^4.139.0"
  }
}
